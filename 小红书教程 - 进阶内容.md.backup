# 进入 skill 目录
cd ~/clawd/skills

# 克隆 weather skill（如果有独立仓库）
# 或者 weather 已内置在 Clawdbot 中

# 检查是否已安装
clawdbot skill list | grep weather

# 启用 weather skill
clawdbot skill enable weather
```

