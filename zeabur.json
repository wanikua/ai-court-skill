{
  "$schema": "https://zeabur.com/schema.json",
  "name": "AI Court",
  "description": "以明朝内阁制为蓝本的多 Agent 协作系统",
  "logo": "https://raw.githubusercontent.com/wanikua/ai-court-skill/main/images/boluobobo-mascot.png",
  "env": {
    "NODE_ENV": {
      "description": "运行环境",
      "value": "production"
    },
    "TZ": {
      "description": "时区",
      "value": "Asia/Shanghai"
    }
  },
  "volumes": [
    {
      "name": "court-config",
      "mountPath": "/home/court/.openclaw",
      "size": 5
    },
    {
      "name": "court-workspace",
      "mountPath": "/home/court/clawd",
      "size": 5
    }
  ]
}
